# Unusual Whales API key (https://unusualwhales.com/dashboard/api). Leave empty for demo mode.
UW_API_KEY=
# Requests per minute to Unusual Whales (stay under your plan's limit).
UW_RPM=100
# Set to 1 to force demo mode even with a key.
TWO_CROWDS_DEMO=
# When hosted: the public host name(s), comma-separated, so the MCP endpoint accepts them (e.g. two-crowds.onrender.com).
PUBLIC_HOSTS=
